{
  "name": "local-creative-os",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @local-creative-os/web",
    "dev:web": "npm run dev --workspace @local-creative-os/web",
    "dev:local-core": "npm run build:local-core && node apps/local-core/dist/index.js",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:open": "node scripts/dev-launcher.mjs open",
    "dev:stop": "node scripts/dev-launcher.mjs stop",
    "dev:status": "node scripts/dev-launcher.mjs status",
    "tray": "powershell -NoProfile -WindowStyle Hidden -File scripts/runtime-host-tray.ps1",
    "dev:target": "node scripts/dev-launcher.mjs target",
    "bridge": "node scripts/light-bridge.mjs",
    "lcos": "node tools/lcos-agent/cli.mjs",
    "lcos:mcp": "node tools/lcos-agent/mcp-server.mjs",
    "lcos:install-skill": "node scripts/install-lcos-codex-skill.mjs",
    "lcos:install-mcp": "node scripts/install-lcos-codex-mcp.mjs",
    "test:lcos-mcp-e2e": "node scripts/lcos-mcp-bridge-e2e.mjs",
    "check:v061-static": "node scripts/validate-v061-static.mjs",
    "check:r31a4-static": "node scripts/validate-r31a4-static.mjs",
    "check:local-core": "npm run check --workspace @local-creative-os/local-core",
    "build": "npm run build --workspace @local-creative-os/web",
    "lint": "npm run lint --workspace @local-creative-os/web && npm run lint --workspace @local-creative-os/local-core && npm run lint --workspace @local-creative-os/domain && npm run lint --workspace @local-creative-os/contracts",
    "preview": "npm run preview --workspace @local-creative-os/web",
    "typecheck": "npm run typecheck --workspace @local-creative-os/web && npm run typecheck --workspace @local-creative-os/local-core && npm run typecheck --workspace @local-creative-os/domain && npm run typecheck --workspace @local-creative-os/contracts && npm run typecheck --workspace @local-creative-os/web-gen2",
    "test": "npm run test --workspace @local-creative-os/web && npm run test --workspace @local-creative-os/local-core && npm run test --workspace @local-creative-os/domain && npm run test --workspace @local-creative-os/contracts",
    "test:report": "vitest run apps/web/tests apps/local-core/tests packages/domain/tests packages/contracts/tests --reporter=json --outputFile=public/dev-test-report.json",
    "test:architecture": "vitest run tests/architecture --reporter=verbose",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:e2e": "npm run build:local-core && npx playwright test --reporter=list",
    "test:e2e:phase-a": "npm run build:local-core && npx playwright test --config=playwright.phase-a.config.ts --reporter=list",
    "preflight:phase-a": "node scripts/phase-a-admission-preflight.mjs",
    "check:phase-a-admission-pack": "node scripts/validate-v015-phase-a-human-smoke-pack.mjs",
    "test:e2e:golden": "node scripts/phase25-golden-path.mjs",
    "test:golden:full": "node scripts/full-golden-path.mjs",
    "audit:manifest:write": "node scripts/reproducibility-manifest.mjs write",
    "audit:manifest:verify": "node scripts/reproducibility-manifest.mjs verify",
    "smoke": "npm run smoke --workspace @local-creative-os/web",
    "check:fast": "npm run check:v015-user-language && npm run lint && npm run typecheck && npm run test && npm run test:architecture && npm run build",
    "check:phase25": "npm run check:fast && npm run test:integration && npm run test:e2e",
    "check": "npm run check:fast",
    "check:gatef-capabilities": "node scripts/validate-gatef-capabilities.mjs",
    "smoke:gatef-core": "npm run build --workspace @local-creative-os/local-core && node scripts/gatef-core-smoke.mjs",
    "build:domain": "npm run build --workspace @local-creative-os/domain",
    "build:contracts": "esbuild packages/contracts/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=packages/contracts/dist/index.js",
    "build:local-core": "npm run build:domain && npm run build:contracts && npm run build --workspace @local-creative-os/local-core",
    "check:gatef-closeout": "node scripts/validate-gatef-closeout.mjs",
    "smoke:obsidian": "npm run build:local-core && node scripts/obsidian-connector-smoke.mjs",
    "smoke:gatef-closeout": "npm run build:local-core && node scripts/gatef-core-smoke.mjs && node scripts/obsidian-connector-smoke.mjs && node scripts/validate-gatef-closeout.mjs",
    "lcos:install-sqlite-vec": "node scripts/install-sqlite-vec.mjs",
    "lcos:mcp:executor": "node tools/lcos-agent/mcp-executor-server.mjs",
    "smoke:conversation": "npm run build:local-core && node scripts/conversation-import-smoke.mjs",
    "smoke:conversation-large": "npm run build:local-core && node scripts/conversation-large-import-smoke.mjs",
    "lcos:bootstrap": "node scripts/bootstrap-lcos.mjs",
    "check:gatef-plus": "node scripts/validate-gatef-plus.mjs",
    "smoke:gatef-plus": "npm run build:local-core && node scripts/conversation-import-smoke.mjs && node scripts/validate-gatef-plus.mjs",
    "smoke:conversation-semantic": "npm run build:local-core && node scripts/conversation-semantic-smoke.mjs",
    "smoke:schema-v18": "npm run build:local-core && node scripts/schema-v18-migration-smoke.mjs",
    "evidence:gatef-plus": "powershell -ExecutionPolicy Bypass -File scripts/gatef-plus-windows-evidence.ps1",
    "watchdog": "node tools/codex-orchestrator/watch.mjs",
    "smoke:watchdog": "node scripts/codex-watchdog-smoke.mjs",
    "smoke:lcosproj-browser": "npm run build:local-core && node scripts/lcosproj-browser-smoke.mjs",
    "smoke:gatef-plus-big": "npm run build:local-core && node scripts/validate-gatef-plus.mjs && node scripts/conversation-import-smoke.mjs && node scripts/conversation-import-recovery-smoke.mjs && node scripts/conversation-semantic-smoke.mjs && node scripts/schema-v18-migration-smoke.mjs && node scripts/codex-watchdog-smoke.mjs && node scripts/lcosproj-browser-smoke.mjs && node scripts/gatef-core-smoke.mjs",
    "smoke:conversation-recovery": "npm run build:local-core && node scripts/conversation-import-recovery-smoke.mjs",
    "check:r31a5-static": "node scripts/validate-r31a5-static.mjs",
    "check:r31a6-static": "node scripts/validate-r31a6-static.mjs",
    "check:r31b1-static": "node scripts/validate-r31b1-static.mjs",
    "check:r31b3-static": "node scripts/validate-r31b3-gui-static.mjs",
    "check:r31b3r4-static": "node scripts/validate-r31b3r4-static.mjs",
    "check:r31b3r5-static": "node scripts/validate-r31b3r5-static.mjs",
    "check:r31b3r6-static": "node scripts/validate-r31b3r6-static.mjs",
    "check:r31b4-static": "node scripts/validate-r31b4-static.mjs",
    "check:r31b5-static": "node scripts/validate-r31b5-static.mjs",
    "check:r31b6-static": "node scripts/validate-r31b6-static.mjs",
    "check:0.1:deterministic": "node scripts/productization-s10-release-gate.mjs --deterministic",
    "check:0.1:release": "node scripts/productization-s10-release-gate.mjs --release",
    "desktop:bridge:build": "node scripts/desktop/build-bridge-windows.mjs",
    "desktop:prepare": "npm run build:local-core && npm run build && node scripts/desktop/prepare-runtime.mjs && npm run desktop:verify",
    "desktop:start": "npm run desktop:prepare && npm run start --workspace @local-creative-os/desktop",
    "desktop:package": "npm run desktop:prepare && npm run package --workspace @local-creative-os/desktop",
    "desktop:make:win": "npm run desktop:bridge:build && npm run desktop:prepare && npm run make --workspace @local-creative-os/desktop",
    "desktop:verify": "node scripts/desktop/verify-runtime.mjs",
    "baseline:bootstrap": "node scripts/desktop/bootstrap-baseline.mjs",
    "desktop:doctor": "node scripts/desktop/doctor.mjs",
    "check:gui:0.1-final": "node scripts/validate-gui-01-final-static.mjs",
    "check:context-cache-static": "node scripts/validate-context-cache-friendly-static.mjs",
    "check:gui:human-round1": "node scripts/validate-main-canvas-human-golden-hotfix.mjs && node scripts/validate-main-canvas-human-golden-round1.mjs && node scripts/validate-gui-human-round1-docs-fence.mjs",
    "windows:finalize:0.1": "powershell -ExecutionPolicy Bypass -File scripts/windows-finalize-lcos-01.ps1",
    "check:spatial-components": "node scripts/validate-spatial-component-foundation.mjs",
    "check:v015-user-language": "node scripts/validate-v015-user-language.mjs",
    "check:v015-r1c": "node scripts/validate-v015-r1c-unified-command-state.mjs",
    "check:v015-r1d": "node scripts/validate-v015-r1d-preview-fragment.mjs",
    "check:v015-r2a": "node scripts/validate-v015-r2a-marker-core-bridge.mjs",
    "check:v015-r2b": "node scripts/validate-v015-r2b-glyth-semantic-lod.mjs",
    "check:v015-r2d": "node scripts/validate-v015-r2d-interaction-grammar.mjs",
    "check:v015-r3a": "node scripts/validate-v015-r3a-colony-catalog.mjs",
    "census": "node scripts/census-capability-map.mjs",
    "check:census": "node scripts/validate-census.mjs",
    "check:v015-s1": "node scripts/validate-execution-item.mjs",
    "check:v015-s2": "node scripts/validate-skill-package.mjs",
    "check:v015-s3": "node scripts/validate-skill-proposal.mjs",
    "check:v015-s4": "node scripts/validate-companion-projection.mjs",
    "check:v015-s8": "node scripts/validate-skill-composition.mjs",
    "check:v015-p0c": "node scripts/validate-v015-p0c.mjs",
    "check:v015-p0d": "node scripts/validate-v015-p0d.mjs",
    "check:v015-s6": "node scripts/validate-v015-s6.mjs",
    "check:v015-s7": "node scripts/validate-v015-s7.mjs",
    "check:v015-s9": "node scripts/validate-v015-s9.mjs && vitest run apps/local-core/tests/semantic-provider-registry.test.ts --reporter=verbose",
    "check:v015-s10": "node scripts/validate-v015-s10.mjs && vitest run apps/local-core/tests/search-format-coverage.test.ts --reporter=verbose"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
